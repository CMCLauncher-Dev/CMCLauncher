<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(Windows81)' == 'true'">net6.0-windows</TargetFramework>
    <LangVersion Condition="'$(Windows81)' == 'true'">12</LangVersion>
    <DefineConstants Condition="'$(Windows81)' == 'true'">$(DefineConstants);WINDOWS81</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CMCLauncher.Avalonia</AssemblyName>
    <RootNamespace>CMCLauncher.Avalonia</RootNamespace>
    <Version>1.0.5</Version>
    <ApplicationIcon>../CMCLauncher.WinUI/assets/cmc-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(Windows81)' == 'true'" Include="../CMCLauncher.Platform/Windows/CMCLauncher.Platform.Windows.csproj" />
    <ProjectReference Include="../CMCLauncher.Core/CMCLauncher.Core.csproj" />
    <ProjectReference Condition="'$(Windows81)' != 'true'" Include="../CMCLauncher.Platform/Linux/CMCLauncher.Platform.Linux.csproj" />
    <ProjectReference Condition="'$(Windows81)' != 'true'" Include="../CMCLauncher.Platform/MacOS/CMCLauncher.Platform.MacOS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.23" />
    <PackageReference
      Include="Avalonia.Desktop"
      Version="11.3.23"
    />
    <PackageReference
      Include="Avalonia.Themes.Fluent"
      Version="11.3.23"
      Condition="'$(Windows81)' == 'true'"
    />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.0" Condition="'$(Windows81)' != 'true'" />
    <PackageReference
      Include="Avalonia.Fonts.Inter"
      Version="11.3.23"
    />
    <PackageReference
      Include="Markdig"
      Version="1.4.2"
    />
    <Content
      Include="../CMCLauncher.Core/Resources/Locales/*.json"
      Link="locales/Default/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../CMCLauncher.Core/Resources/Themes/*.json"
      Link="themes/Default/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Target
    Name="RejectWindowsAvaloniaPublish"
    BeforeTargets="PrepareForPublish;Publish"
    Condition="'$(Windows81)' != 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
  >
    <Error Text="Windows releases use CMCLauncher.WinUI. Publish Avalonia for Linux or macOS." />
  </Target>
  <ItemGroup>
    <Content Include="../CMCLauncher.WinUI/assets/cmc-logo.png" Link="assets/cmc-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../CMCLauncher.WinUI/assets/about/*.png"
      Link="assets/about/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
