<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-specific services; referenced only by Windows hosts. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CMCLauncher.Platform.Windows</AssemblyName>
    <RootNamespace>CMCLauncher</RootNamespace>
    <Version>1.0.5</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CMCLauncher.Core/CMCLauncher.Core.csproj" />
    <EmbeddedResource
      Include="LauncherUpdateWorker.ps1"
      LogicalName="CMCLauncher.UpdateWorker"
    />
  </ItemGroup>
</Project>
