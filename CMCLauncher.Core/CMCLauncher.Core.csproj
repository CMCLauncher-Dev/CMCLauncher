<Project Sdk="Microsoft.NET.Sdk">
  <!-- Portable services; no WinUI or Windows SDK dependency. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <AssemblyName>CMCLauncher.Core</AssemblyName>
    <RootNamespace>CMCLauncher</RootNamespace>
    <Version>1.0.3</Version>
    <CurseForgeConfigurationFile
      Condition="'$(CurseForgeConfigurationFile)' == ''"
    >$(MSBuildProjectDirectory)/../winui/curseforge.local.json</CurseForgeConfigurationFile>
  </PropertyGroup>
  <!-- 本地构建可嵌入公开 OAuth 客户端 ID，源文件不进入发行包。 -->
  <ItemGroup>
    <EmbeddedResource
      Include="../winui/themes/craft.json"
      LogicalName="CMCLauncher.Themes.craft.json"
    />

    <EmbeddedResource
      Include="../winui/locales/*.json"
      LogicalName="CMCLauncher.Locales.%(Filename).json"
    />
    <EmbeddedResource
      Include="../winui/clientid.local.json"
      LogicalName="CMCLauncher.MicrosoftClient"
      Condition="Exists('../winui/clientid.local.json')"
    />
    <EmbeddedResource
      Include="$(CurseForgeConfigurationFile)"
      LogicalName="CMCLauncher.CurseForgeApi"
      Condition="Exists('$(CurseForgeConfigurationFile)')"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference
      Include="AngleSharp"
      Version="1.9.1"
    />
  </ItemGroup>
</Project>
