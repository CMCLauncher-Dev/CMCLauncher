<Application
  x:Class="CMCLauncher.WinUI.CMCApp"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:CMCLauncher.WinUI"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls"
>
  <Application.Resources>
    <ResourceDictionary>
      <!-- 先加载 WinUI 默认控件资源，下面再补充应用的主题色和样式。 -->
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>
      <!-- 这些资源随 RequestedTheme 切换，代码创建的配色画刷另由 ApplyTheme 更新。 -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush
            x:Key="NavigationViewSelectionIndicatorForeground"
            Color="#416D37"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemForegroundSelected"
            Color="#30592B"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelected"
            Color="#DDE8D6"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelectedPointerOver"
            Color="#D4E1CB"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelectedPressed"
            Color="#CBD9C0"
          />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush
            x:Key="NavigationViewSelectionIndicatorForeground"
            Color="#536DBD"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemForegroundSelected"
            Color="#91A9F0"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelected"
            Color="#2C3550"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelectedPointerOver"
            Color="#354260"
          />
          <SolidColorBrush
            x:Key="NavigationViewItemBackgroundSelectedPressed"
            Color="#3F4F75"
          />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      </Style>
      <ControlTemplate x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Border Background="Transparent" />
      </ControlTemplate>
      <ControlTemplate x:Key="ThinScrollThumb" TargetType="Thumb">
        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
      </ControlTemplate>
      <Style TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="local:ScrollBarAppearance.Attach" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid x:Name="Root" Background="Transparent">
                <Grid x:Name="HorizontalRoot" Height="8" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <Thumb x:Name="HorizontalThumb" Grid.Column="2" Height="4" MinWidth="24" Background="#888888" Template="{StaticResource ThinScrollThumb}" />
                </Grid>
                <Grid x:Name="VerticalRoot" Width="8" Background="Transparent">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" MinWidth="0" MinHeight="0" IsTabStop="False" Template="{StaticResource ScrollTrackButton}" />
                  <Thumb x:Name="VerticalThumb" Grid.Row="2" Width="4" MinHeight="24" Background="#888888" Template="{StaticResource ThinScrollThumb}" />
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TextBox">
        <Setter
          Property="Padding"
          Value="11,5,11,6"
        />
        <Setter
          Property="MinHeight"
          Value="32"
        />
        <Setter
          Property="ScrollViewer.VerticalScrollBarVisibility"
          Value="Auto"
        />
        <Setter
          Property="ScrollViewer.HorizontalScrollBarVisibility"
          Value="Hidden"
        />
      </Style>
      <Style TargetType="PasswordBox">
        <Setter
          Property="Padding"
          Value="11,5,11,6"
        />
        <Setter
          Property="MinHeight"
          Value="32"
        />
      </Style>
      <Style TargetType="NumberBox">
        <Setter
          Property="MinHeight"
          Value="32"
        />
      </Style>
      <Style TargetType="NavigationViewItem">
        <Setter
          Property="MinHeight"
          Value="34"
        />
        <Setter
          Property="Height"
          Value="36"
        />
        <Setter
          Property="FontSize"
          Value="14"
        />
        <Setter
          Property="Margin"
          Value="0,2,0,2"
        />
        <Setter
          Property="CornerRadius"
          Value="4"
        />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
